  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#6c7086",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.logical.python",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#94e2d5"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#89b4fa"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f5c2e7"
      }
    },
    {
      "name": "Number/Constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant",
        "constant.language.python"
      ],
      "settings": {
        "foreground": "#fab387"
      }
    },
    {
      "name": "Type/Class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type.class.python",
        "support.type.python",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#f9e2af"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator",
        "entity.name.decorator"
      ],
      "settings": {
        "foreground": "#f5c2e7"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#eba0ac",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Self",
      "scope": [
        "variable.language",
        "variable.language.self",
        "variable.parameter.function.language.special.self.python",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#f38ba8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.attribute",
        "support.variable.property",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#b4befe"
      }
    },
    {
      "name": "Module",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.module",
        "support.other.namespace",
        "variable.other.namespace"
      ],
      "settings": {
        "foreground": "#89dceb"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#cba6f7"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#9399b2"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#cdd6f4"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#89b4fa",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#fab387",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f5c2e7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#a6e3a1"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#89dceb"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ff5f5f"
      }
    }
  ],
  "semanticTokenColors": {
    "function": "#89b4fa",
    "method": "#89b4fa",
    "class": "#f9e2af",
    "type": "#f9e2af",
    "enum": "#f9e2af",
    "interface": "#f9e2af",
    "typeParameter": "#f9e2af",
    "parameter": {
      "foreground": "#eba0ac",
      "italic": true
    },
    "property": "#b4befe",
    "enumMember": "#fab387",
    "variable.readonly": "#fab387",
    "variable": "#cdd6f4",
    "selfParameter": {
      "foreground": "#f38ba8",
      "italic": true
    },
    "decorator": "#f5c2e7",
    "namespace": "#89dceb",
    "module": "#89dceb",
    "keyword": "#cba6f7",
    "*.defaultLibrary": {},
    "function.defaultLibrary": "#89b4fa",
    "class.builtin": "#f9e2af"
  }
}